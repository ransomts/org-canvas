#!/bin/sh
# org-canvas --- run an org-canvas command against a course from the shell
#
#   scripts/org-canvas [-C DIR] [--dry-run] COMMAND [ARGS...]
#   scripts/org-canvas --help
#
# The course directory defaults to the current one; its
# org-canvas-credentials.el is loaded.  EMACS names the Emacs to run
# (default: emacs); ORG_CANVAS_LISP the directory holding
# org-canvas-batch.el (default: ../lisp beside this script, symlinks
# followed); ORG_CANVAS_LOAD_PATH extra load-path directories,
# separated by colons.  The exit status is the command's own: 0 done,
# 1 drift, validation errors or a failed item, 2 usage, 3 error
# (issue #416).
script=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
lisp=${ORG_CANVAS_LISP:-$(dirname "$script")/../lisp}
exec "${EMACS:-emacs}" --batch -l "$lisp/org-canvas-batch.el" \
     -f org-canvas-batch -- "$@"
