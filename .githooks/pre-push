#!/usr/bin/env bash
# pre-push hook: regression test on Emacs 29 + 30 via Nix, enforce coverage
#
# This hook runs automatically before every `git push`. It gates pushes on:
#   1. Lint clean (eldev lint — doc, package, re linters)
#   2. Cognitive complexity within budget (eldev complexity)
#   3. All tests passing on both Emacs 29 and Emacs 30 (via nix-shell)
#   4. Code coverage >= 99% (measured on the Emacs 30 run)
#
# Emacs versions are pinned to specific nixpkgs archives so results are
# reproducible regardless of the developer's system Emacs.
#
# Requires: nix-shell, eldev
# Configure: git config core.hooksPath .githooks
set -euo pipefail

COVERAGE_TARGET=99
COMPLEXITY_BUDGET=2  # pre-existing: org-canvas-define-sync, org-canvas-define-push-at-point

# Gate 1: Lint must be clean (fast — runs before slower nix-shell tests).
echo "Running linter..."
if ! eldev lint 2>&1; then
  echo "BLOCKED: eldev lint reported warnings."
  exit 1
fi
echo ""

# Gate 2: No new functions above cognitive complexity threshold (>15).
# Budget allows the 2 pre-existing macro violations; any increase is blocked.
echo "Checking cognitive complexity..."
complexity_output=$(eldev complexity 2>&1)
violations=$(echo "$complexity_output" | grep -oP '\d+(?= above cognitive threshold)' || echo "0")

if [ "$violations" -gt "$COMPLEXITY_BUDGET" ]; then
  echo "$complexity_output" | grep -i "very.high"
  echo "BLOCKED: $violations function(s) above threshold (budget: $COMPLEXITY_BUDGET)."
  exit 1
fi
echo "Complexity OK ($violations/$COMPLEXITY_BUDGET budget used)."
echo ""

# Pin each Emacs version to a specific nixpkgs snapshot
declare -A NIX_ARCHIVES=(
  [29]="https://github.com/NixOS/nixpkgs/archive/nixos-24.05.tar.gz"
  [30]="https://github.com/NixOS/nixpkgs/archive/nixos-24.11.tar.gz"
)

declare -A NIX_PACKAGES=(
  [29]="emacs29-nox"
  [30]="emacs30-nox"
)

# Test both versions sequentially: Emacs 29 first (faster, no coverage),
# then Emacs 30 with undercover coverage reporting enabled.
for version in 29 30; do
  archive="${NIX_ARCHIVES[$version]}"
  package="${NIX_PACKAGES[$version]}"

  echo "========================================"
  echo " Emacs $version ($package)"
  echo "========================================"

  # Only enable coverage instrumentation on Emacs 30 (primary target).
  # Emacs 29 runs plain tests — catches version-specific regressions without
  # the overhead of undercover instrumentation.
  if [ "$version" -eq 30 ]; then
    cmd="emacs --version | head -1 && eldev test -u \"on,text,dontsend\""
  else
    cmd="emacs --version | head -1 && eldev test"
  fi

  # Run tests inside a nix-shell with the pinned Emacs version.
  # Capture all output so we can parse failures and coverage.
  output=$(nix-shell \
    -I "nixpkgs=$archive" \
    -p "$package" \
    --run "$cmd" 2>&1)

  echo "$output"
  echo ""

  # Gate 3: Block push if any test specs failed on this Emacs version.
  if echo "$output" | grep -qE '[0-9]+ failed'; then
    failed=$(echo "$output" | grep -oP '\d+ failed' | grep -oP '^\d+')
    if [ "$failed" -gt 0 ]; then
      echo "BLOCKED: $failed test(s) failed on Emacs $version."
      echo "$output" | grep -E 'FAILED|failed' | tail -20
      exit 1
    fi
  fi

  # Gate 4: Enforce minimum code coverage (Emacs 30 only).
  # Parse per-module "Relevant: N Covered: M" lines from undercover output,
  # sum them into a weighted average, and compare against the target.
  if [ "$version" -eq 30 ]; then
    total_relevant=0
    total_covered=0

    while IFS= read -r line; do
      relevant=$(echo "$line" | grep -oP 'Relevant: \K\d+')
      covered=$(echo "$line" | grep -oP 'Covered: \K\d+')
      total_relevant=$((total_relevant + relevant))
      total_covered=$((total_covered + covered))
    done < <(echo "$output" | grep -P '^org-canvas.*Percent')

    if [ "$total_relevant" -eq 0 ]; then
      echo "BLOCKED: Could not parse coverage report."
      exit 1
    fi

    # Integer division: 6446 * 100 / 6510 = 99
    coverage=$((total_covered * 100 / total_relevant))

    echo "Coverage: ${coverage}% (${total_covered}/${total_relevant} lines)"

    if [ "$coverage" -lt "$COVERAGE_TARGET" ]; then
      echo "BLOCKED: Coverage ${coverage}% is below target ${COVERAGE_TARGET}%."
      exit 1
    fi
  fi
done

echo "All checks passed (${coverage}% >= ${COVERAGE_TARGET}%)."
