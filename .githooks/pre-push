#!/usr/bin/env bash
# pre-push hook: regression test on Emacs 29 + 30 via Nix, enforce coverage
#
# This hook runs automatically before every `git push`. It gates pushes on:
#   1. Lint clean (eldev lint — doc, package, re linters), under the
#      same Emacs 30 CI lints with: checkdoc on 30.1 rejects a
#      third-person verb anywhere in a docstring's first line, and a
#      newer system Emacs lets it through (PRs #89, #90, #189, #258, #259)
#   2. Cognitive complexity within budget (eldev complexity)
#   3. All tests passing on both Emacs 29 and Emacs 30 (via nix-shell)
#   4. Code coverage >= 99% (measured on the Emacs 30 run)
#
# Gates 1+2 run one after the other (they shared the .eldev cache and
# raced on its lock when run in parallel, blocking pushes with no real
# warning; issue #244), then gates 3+4 run in parallel.
#
# Emacs versions are pinned to specific nixpkgs archives so results are
# reproducible regardless of the developer's system Emacs.
#
# Requires: nix-shell, eldev
# Configure: git config core.hooksPath .githooks
set -euo pipefail

COVERAGE_TARGET=99
COMPLEXITY_BUDGET=2  # pre-existing: org-canvas-define-sync, org-canvas-define-push-at-point

# Pin each Emacs version to a specific nixpkgs snapshot
declare -A NIX_ARCHIVES=(
  [29]="https://github.com/NixOS/nixpkgs/archive/nixos-24.05.tar.gz"
  [30]="https://github.com/NixOS/nixpkgs/archive/nixos-24.11.tar.gz"
)

declare -A NIX_PACKAGES=(
  [29]="emacs29-nox"
  [30]="emacs30-nox"
)

# --- Phase 1: Lint (Emacs 30), then Complexity ---

LINT_LOG=$(mktemp /tmp/org-canvas-lint-XXXXXX.log)
COMPLEXITY_LOG=$(mktemp /tmp/org-canvas-complexity-XXXXXX.log)

echo "Running linter (Emacs 30, as CI does)..."
lint_rc=0
nix-shell \
  -I "nixpkgs=${NIX_ARCHIVES[30]}" \
  -p "${NIX_PACKAGES[30]}" \
  --keep PATH \
  --run "emacs --version | head -1 && eldev lint" > "$LINT_LOG" 2>&1 || lint_rc=$?
cat "$LINT_LOG" || true
if [ "$lint_rc" -ne 0 ]; then
  # A linter that never ran (a cache lock, a missing dependency) is not
  # a finding; say which it was so nobody hunts for a docstring problem
  # that does not exist.
  if grep -q "Linting produced warnings" "$LINT_LOG"; then
    echo "BLOCKED: eldev lint reported warnings."
  else
    echo "BLOCKED: eldev lint did not complete (exit $lint_rc); see the log above and push again."
  fi
  rm -f "$LINT_LOG" "$COMPLEXITY_LOG"
  exit 1
fi
echo ""

eldev complexity > "$COMPLEXITY_LOG" 2>&1 || true

# Check complexity
complexity_output=$(cat "$COMPLEXITY_LOG")
if ! echo "$complexity_output" | grep -q "above cognitive threshold"; then
  echo "Checking cognitive complexity..."
  echo "$complexity_output"
  echo "BLOCKED: eldev complexity did not complete; see the log above and push again."
  rm -f "$LINT_LOG" "$COMPLEXITY_LOG"
  exit 1
fi
violations=$(echo "$complexity_output" | grep -oP '\d+(?= above cognitive threshold)' || echo "0")

if [ "$violations" -gt "$COMPLEXITY_BUDGET" ]; then
  echo "Checking cognitive complexity..."
  echo "$complexity_output" | grep -i "very.high"
  echo "BLOCKED: $violations function(s) above threshold (budget: $COMPLEXITY_BUDGET)."
  rm -f "$LINT_LOG" "$COMPLEXITY_LOG"
  exit 1
fi
echo "Checking cognitive complexity..."
echo "Complexity OK ($violations/$COMPLEXITY_BUDGET budget used)."
echo ""

rm -f "$LINT_LOG" "$COMPLEXITY_LOG"

# --- Phase 2: Emacs 29 + Emacs 30 tests (parallel) ---

EMACS29_LOG=$(mktemp /tmp/org-canvas-emacs29-XXXXXX.log)
EMACS30_LOG=$(mktemp /tmp/org-canvas-emacs30-XXXXXX.log)
COVERAGE_JSON=$(mktemp /tmp/org-canvas-coverage-XXXXXX.json)

# Emacs 29: plain tests (no coverage overhead)
(
  # Git runs this hook with GIT_DIR, GIT_WORK_TREE and friends in the
  # environment, and nix-shell passes them through to eldev test, so
  # specs that shell out to git inherit the repository being pushed
  # instead of the filesystem: a temp dir "outside a checkout" resolved
  # to the pushed commit, and #549's tracked-files guard fired under
  # /tmp (#560).  Scrub them so the suites see the world CI does.
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES
  nix-shell \
    -I "nixpkgs=${NIX_ARCHIVES[29]}" \
    -p "${NIX_PACKAGES[29]}" \
    --keep PATH \
    --run "emacs --version | head -1 && eldev test" > "$EMACS29_LOG" 2>&1
  echo $? > "${EMACS29_LOG}.rc"
) &
emacs29_pid=$!

# Emacs 30: tests with coverage
(
  # Scrub git's hook environment here too, for the same reason as the
  # Emacs 29 run above (#560).
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES
  nix-shell \
    -I "nixpkgs=${NIX_ARCHIVES[30]}" \
    -p "${NIX_PACKAGES[30]}" \
    --keep PATH \
    --run "emacs --version | head -1 && eldev test -u \"on,codecov,dontsend\" -U \"$COVERAGE_JSON\"" > "$EMACS30_LOG" 2>&1
  echo $? > "${EMACS30_LOG}.rc"
) &
emacs30_pid=$!

wait "$emacs29_pid" "$emacs30_pid" || true

# --- Validate Emacs 29 ---
echo "========================================"
echo " Emacs 29 (${NIX_PACKAGES[29]})"
echo "========================================"
cat "$EMACS29_LOG" || true
echo ""

# A direct file grep, never `echo "$(cat ...)" | grep -q`: on a log
# this size grep -q exits at its first match while echo is still
# writing, echo dies of SIGPIPE (141), and under `pipefail` above the
# whole condition reads false — the gate was unreachable (#560).
if grep -qE '[0-9]+ failed' "$EMACS29_LOG"; then
  # Buttercup's tally line ("Ran N specs, F failed") carries the
  # failure count.  The suite's own stdout logs an "N failed" summary
  # for every sync a spec runs ("0 failed" on a green run), and a
  # count taken from every match came out multi-line, so the
  # comparison below errored its way to false and this gate never
  # fired (#560).
  failed=$(grep -oP 'specs, \K\d+(?= failed)' "$EMACS29_LOG" | head -1)
  if [ "${failed:-0}" -gt 0 ]; then
    echo "BLOCKED: $failed test(s) failed on Emacs 29."
    grep -E 'FAILED|failed' "$EMACS29_LOG" | tail -20
    rm -f "$EMACS29_LOG" "${EMACS29_LOG}.rc" "$EMACS30_LOG" "${EMACS30_LOG}.rc" "$COVERAGE_JSON"
    exit 1
  fi
fi

# --- Validate Emacs 30 ---
echo "========================================"
echo " Emacs 30 (${NIX_PACKAGES[30]})"
echo "========================================"
cat "$EMACS30_LOG" || true
echo ""

# Direct file grep here too, as above (#560).
if grep -qE '[0-9]+ failed' "$EMACS30_LOG"; then
  # Buttercup's tally alone, as in the Emacs 29 gate above (#560).
  failed=$(grep -oP 'specs, \K\d+(?= failed)' "$EMACS30_LOG" | head -1)
  if [ "${failed:-0}" -gt 0 ]; then
    echo "BLOCKED: $failed test(s) failed on Emacs 30."
    grep -E 'FAILED|failed' "$EMACS30_LOG" | tail -20
    rm -f "$EMACS29_LOG" "${EMACS29_LOG}.rc" "$EMACS30_LOG" "${EMACS30_LOG}.rc" "$COVERAGE_JSON"
    exit 1
  fi
fi

# --- Gate 4: Coverage (Emacs 30 only) ---
if [ ! -s "$COVERAGE_JSON" ]; then
  echo "BLOCKED: Coverage JSON was not generated."
  rm -f "$EMACS29_LOG" "${EMACS29_LOG}.rc" "$EMACS30_LOG" "${EMACS30_LOG}.rc" "$COVERAGE_JSON"
  exit 1
fi

eval "$(python3 -c "
import json, sys
with open('$COVERAGE_JSON') as f:
    data = json.load(f)
relevant = covered = 0
for sf in data['source_files']:
    for hit in sf['coverage']:
        if hit is not None:
            relevant += 1
            if hit > 0:
                covered += 1
print(f'total_relevant={relevant}')
print(f'total_covered={covered}')
")"

rm -f "$EMACS29_LOG" "${EMACS29_LOG}.rc" "$EMACS30_LOG" "${EMACS30_LOG}.rc" "$COVERAGE_JSON"

if [ "$total_relevant" -eq 0 ]; then
  echo "BLOCKED: Could not parse coverage report."
  exit 1
fi

# Round to nearest integer (add half-divisor before dividing)
coverage=$(( (total_covered * 100 + total_relevant / 2) / total_relevant ))

echo "Coverage: ${coverage}% (${total_covered}/${total_relevant} lines)"

if [ "$coverage" -lt "$COVERAGE_TARGET" ]; then
  echo "BLOCKED: Coverage ${coverage}% is below target ${COVERAGE_TARGET}%."
  exit 1
fi

echo "All checks passed (${coverage}% >= ${COVERAGE_TARGET}%)."
