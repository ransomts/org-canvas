;;; org-canvas-module-tree-test.el --- Architecture-guide module-tree drift guard  -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:

;; Guards the module tree in documentation/architecture-guide.md,
;; which ends with "`ls lisp/` is the authority; update this tree when
;; a file is added".  Nothing checked that until this spec:
;; submissions-ruling and submissions-uploads existed for weeks
;; without a tree line.  A failure means a module was added or removed
;; without editing the tree — or the tree names a file that no longer
;; exists.  The two gitignored locals (autoloads, credentials) are
;; listed in the tree but not held by a checkout, and the tree's one
;; pattern row (org-canvas-{feature}.el) is not a file.

;;; Code:

(require 'buttercup)
(require 'cl-lib)

(defconst org-canvas-module-tree--guide
  (let ((rel "documentation/architecture-guide.md"))
    (cond ((file-exists-p rel) (expand-file-name rel))
          ((file-exists-p (expand-file-name rel default-directory))
           (expand-file-name rel default-directory))
          (t rel)))
  "Path to the architecture guide.")

(defconst org-canvas-module-tree--lisp
  (let ((rel "lisp"))
    (cond ((file-exists-p rel) (expand-file-name rel))
          ((file-exists-p (expand-file-name rel default-directory))
           (expand-file-name rel default-directory))
          (t rel)))
  "Path to the package sources, the tree's authority.")

(defconst org-canvas-module-tree--untracked
  '("org-canvas-autoloads.el" "org-canvas-credentials.el")
  "Tree entries a checkout does not hold.
Autoloads are generated by Eldev, credentials are the developer's
own: both are gitignored, so neither reaches a fresh clone.")

(defun org-canvas-module-tree--tree-modules ()
  "Module file names the architecture guide's tree lists."
  (if (not (file-exists-p org-canvas-module-tree--guide))
      nil
    (with-temp-buffer
      (insert-file-contents org-canvas-module-tree--guide)
      (let (names)
        (goto-char (point-min))
        (while (re-search-forward
                "^[├└]── \\(org-canvas[^ ]*\\.el\\)" nil t)
          (let ((name (match-string 1)))
            (unless (or (string-match-p "[{}]" name)
                        (member name org-canvas-module-tree--untracked))
              (cl-pushnew name names :test #'string=))))
        (nreverse names)))))

(defun org-canvas-module-tree--lisp-modules ()
  "Module file names in lisp/, the tree's authority."
  (cl-remove-if (lambda (name)
                  (member name org-canvas-module-tree--untracked))
                (directory-files org-canvas-module-tree--lisp nil
                                "\\.el\\'")))

(defun org-canvas-module-tree--missing-from-tree ()
  "The lisp/ files the guide's tree does not list."
  (cl-set-difference (org-canvas-module-tree--lisp-modules)
                     (org-canvas-module-tree--tree-modules)
                     :test #'string=))

(defun org-canvas-module-tree--missing-from-lisp ()
  "The tree entries naming no file in lisp/."
  (cl-set-difference (org-canvas-module-tree--tree-modules)
                     (org-canvas-module-tree--lisp-modules)
                     :test #'string=))

(describe "the architecture guide's module tree"
  (it "lists every module file in lisp/"
    (expect (org-canvas-module-tree--missing-from-tree) :to-equal '()))

  (it "names no module file that lisp/ does not hold"
    (expect (org-canvas-module-tree--missing-from-lisp) :to-equal '())))

;;; org-canvas-module-tree-test.el ends here
