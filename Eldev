;;; Eldev --- Eldev configuration file  -*- lexical-binding: t; -*-

(setf eldev-project-source-dirs '("lisp"))
(setf eldev-project-main-file "org-canvas.el")

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'melpa)

(eldev-use-plugin 'autoloads)

;; Code coverage with undercover
(eldev-use-plugin 'undercover)
(setf eldev-undercover-fileset
      '("lisp/*.el"
        ;; The two gitignored locals: generated autoloads, the
        ;; developer's own credentials.  A glob, not a hand-maintained
        ;; list, so a module is instrumented the moment it is added
        ;; (issue #522) -- the module tree is spec-guarded and the
        ;; status table registry-derived; this was the last list that
        ;; could forget one.
        "!lisp/org-canvas-autoloads.el"
        "!lisp/org-canvas-credentials.el"))
;; Use codecov format with local report file (don't auto-send)
(setf eldev-undercover-report-format 'codecov)
(setf eldev-undercover-send-report nil)

;; Test configuration - use Buttercup
(setf eldev-test-framework 'buttercup)
(eldev-add-extra-dependencies 'test 'buttercup)
(eldev-add-extra-dependencies 'test 'buttercup-junit)
(eldev-add-extra-dependencies 'test 'undercover)
(setf eldev-test-fileset '("./test/*.el"))
(push "test" eldev-project-source-dirs)

;; JUnit XML reporter for Codecov Test Analytics
;; Set ELDEV_JUNIT=1 to enable JUnit XML output
(when (getenv "ELDEV_JUNIT")
  (with-eval-after-load 'buttercup
    (require 'buttercup-junit)
    (setq buttercup-reporter #'buttercup-junit-reporter)
    (setq buttercup-junit-result-file
          (or (getenv "JUNIT_REPORT_FILE") "test-results.xml"))))

;; Exclude vendor directory from linting
(setf eldev-lint-ignored-fileset '("vendor/" "test/" "scripts/"))

;; Keep scripts/ out of every standard fileset (compile, package).  They are
;; standalone batch programs: scripts/mutation-test.el ends in a top-level
;; (mutant--report) call, which byte-compilation executes, so a plain
;; eldev compile used to start a full mutation run that rewrote lisp/ files
;; and spawned eldev test per mutant.
(setf eldev-standard-excludes (append eldev-standard-excludes '("./scripts/")))

;;; Project commands

;; The complexity analyzer is a file of its own: this file says how the
;; project builds, and the metric walks and the report are a command in
;; their own right.  scripts/ is outside every standard Eldev fileset
;; (see above), so loading it here is what keeps `eldev complexity'
;; working without putting the analyzer in the package.
(load (expand-file-name "scripts/complexity.el" eldev-project-dir)
      nil 'nomessage)
